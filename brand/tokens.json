{
  "$comment": "Tessera design tokens — the single source of truth. The docs site and the future frontend consume this file; a second palette or type scale anywhere is a bug. Licence: Apache-2.0 (c) 2026 The Tessera Project.",
  "version": "1.0.0",
  "color": {
    "zinc": {
      "50": "#fafafa",
      "100": "#f4f4f5",
      "200": "#e4e4e7",
      "300": "#d4d4d8",
      "400": "#a1a1aa",
      "500": "#71717a",
      "600": "#52525b",
      "700": "#3f3f46",
      "800": "#27272a",
      "900": "#18181b",
      "950": "#09090b"
    },
    "accent": {
      "$comment": "Exactly one accent. Used for what is being placed: the tile, the active state, the recommendation. Never decorative.",
      "500": "#6E96E8"
    },
    "semantic": {
      "$comment": "State colours for UI semantics (risk, success) — functional, not decorative. ORIGIN/risk uses the deep rust; success is a desaturated green. These do not join the decorative palette.",
      "risk": "#C84B41",
      "success": "#4F8A5B"
    },
    "theme": {
      "light": {
        "background": "#fafafa",
        "surface": "#ffffff",
        "ink": "#18181b",
        "ink-muted": "#52525b",
        "line": "#e4e4e7"
      },
      "dark": {
        "background": "#09090b",
        "surface": "#18181b",
        "ink": "#fafafa",
        "ink-muted": "#a1a1aa",
        "line": "#27272a"
      }
    }
  },
  "typography": {
    "text": {
      "family": "Inter",
      "source": "brand/fonts/InterVariable.woff2",
      "licence": "SIL OFL 1.1",
      "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
    },
    "mono": {
      "family": "JetBrains Mono",
      "source": "brand/fonts/JetBrainsMono-Regular.woff2",
      "licence": "SIL OFL 1.1",
      "weights": { "regular": 400, "medium": 500 }
    },
    "scale": {
      "caption": { "size": 12, "lineHeight": 1.4 },
      "body-s": { "size": 14, "lineHeight": 1.5 },
      "body": { "size": 16, "lineHeight": 1.6 },
      "h3": { "size": 20, "lineHeight": 1.4, "weight": 600 },
      "h2": { "size": 24, "lineHeight": 1.3, "weight": 600 },
      "h1": { "size": 32, "lineHeight": 1.2, "weight": 700 },
      "display": { "size": 48, "lineHeight": 1.1, "weight": 700 }
    }
  },
  "spacing": {
    "$comment": "4px base grid; the named steps are the only legal gaps.",
    "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64
  },
  "radius": {
    "card": 10,
    "control": 6,
    "icon": 4
  }
}
