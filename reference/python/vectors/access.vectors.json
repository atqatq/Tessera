      "name": "origin_with_recorded_intent_is_allowed",
      "env": {
        "now": 1000,
        "module_enabled": true,
        "known_columns": [
          "sku",
          "qty",
          "price"
        ],
        "rules": [
          {
            "role": "planner",
            "module": "inv",
            "action": "read",
            "column": "*",
            "effect": "allow"
          }
        ],
        "grants": [],
        "agent_allowlist": [],
        "origin_approvals": []
      },
      "request": {
        "target": "inv",
        "action": "read",
        "columns": [
          "sku"
        ],
        "actor": {
          "kind": "origin",
          "subject": "root"
        },
        "home": "inv",
        "origin_intent": "int-1"
      },
      "expected": {
        "code": "allow_origin",
        "layer": "origin"
      }
    },
